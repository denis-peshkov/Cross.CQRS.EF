<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Cross.CQRS.EF</id>
    <version>0.0.0</version>
    <authors>Denis Peshkov</authors>
    <owners>Denis Peshkov</owners>
    <projectUrl>https://github.com/denis-peshkov/Cross.CQRS.EF</projectUrl>
    <repository type="git" url="https://github.com/denis-peshkov/Cross.CQRS.EF.git" />
    <icon>icon.png</icon>
    <readme>docs\README.md</readme>
    <copyright>Copyright 2026 Denis Peshkov</copyright>
    <license type="file">LICENSE.md</license>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>Simple .NET MediatR base EF Transactional Behavior for Cross.CQRS.</description>
    <tags>.NET MediatR EF Core TransactionalBehavior ExactTransaction DbContext CQRS NetCore</tags>
    <releaseNotes><![CDATA[
Cross.CQRS.EF — AddEntityFrameworkIntegration: UnifiedTransactionBehavior, TransactionBehaviorOptions / ExactTransaction, EF license pipeline slot (−1) + hosted validator. Pagination APIs removed from this package. TFMs net6–net10.

Changelog: https://github.com/denis-peshkov/Cross.CQRS.EF/blob/master/docs/CHANGELOG.md
Breaking: https://github.com/denis-peshkov/Cross.CQRS.EF/blob/master/docs/BREAKING.md
]]></releaseNotes>
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="Cross.CQRS" version="11.1.2" />
        <dependency id="Microsoft.EntityFrameworkCore" version="6.0.36" />
        <dependency id="Microsoft.EntityFrameworkCore.Relational" version="6.0.36" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="6.0.1" />
      </group>
      <group targetFramework="net7.0">
        <dependency id="Cross.CQRS" version="11.1.2" />
