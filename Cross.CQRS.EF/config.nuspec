        <dependency id="Microsoft.EntityFrameworkCore" version="9.0.14" />
        <dependency id="Microsoft.EntityFrameworkCore.Relational" version="9.0.14" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="9.0.14" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="Cross.CQRS" version="11.1.2" />
        <dependency id="Microsoft.EntityFrameworkCore" version="10.0.5" />
        <dependency id="Microsoft.EntityFrameworkCore.Relational" version="10.0.5" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="10.0.5" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="System.Core" targetFramework="net6.0" />
      <frameworkAssembly assemblyName="System.Core" targetFramework="net7.0" />
      <frameworkAssembly assemblyName="System.Core" targetFramework="net8.0" />
      <frameworkAssembly assemblyName="System.Core" targetFramework="net9.0" />
      <frameworkAssembly assemblyName="System.Core" targetFramework="net10.0" />
