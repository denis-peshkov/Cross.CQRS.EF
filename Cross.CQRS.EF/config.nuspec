        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="7.0.0" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Cross.CQRS" version="11.1.2" />
        <dependency id="Microsoft.EntityFrameworkCore" version="8.0.25" />
        <dependency id="Microsoft.EntityFrameworkCore.Relational" version="8.0.25" />
        <dependency id="Microsoft.Extensions.Hosting.Abstractions" version="8.0.1" />
      </group>
      <group targetFramework="net9.0">
